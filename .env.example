# Local dev environment for CineMind.
# Copy to `.env` (backend + frontend read their own copies) and fill in real values.

# ================= Backend =================
# Postgres connection string (SQLAlchemy URL). Docker Compose maps these exact values.
CINEMIND_DATABASE_URL=postgresql+asyncpg://cinemind:cinemind@localhost:5432/cinemind

# TMDb API key (https://www.themoviedb.org/settings/api)
CINEMIND_TMDB_API_KEY=

# OpenAI-compatible settings (works with OpenAI, Ollama, LM Studio, OpenRouter, ...)
CINEMIND_LLM_BASE_URL=https://api.openai.com/v1
CINEMIND_LLM_API_KEY=
CINEMIND_LLM_MODEL=gpt-4o-mini

# Embeddings: OpenAI text-embedding-3-large by default.
# To cut cost, set CINEMIND_EMBEDDING_PROVIDER=local (sentence-transformers) — see backend README.
CINEMIND_EMBEDDING_PROVIDER=openai
CINEMIND_EMBEDDING_MODEL=text-embedding-3-large
CINEMIND_EMBEDDING_DIMENSIONS=1536

# Backend server
CINEMIND_HOST=0.0.0.0
CINEMIND_PORT=8000
CINEMIND_CORS_ORIGINS=http://localhost:3000
CINEMIND_LOG_LEVEL=INFO

# ================= Frontend =================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
