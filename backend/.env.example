# CineMind backend environment.
# Copy to backend/.env and fill in real values. Never commit .env.

# --- Database (SQLAlchemy URL; docker-compose maps Postgres to localhost:5432) ---
DATABASE_URL=postgresql+asyncpg://cinemind:cinemind@localhost:5432/cinemind

# --- Auth ---
# Used to sign user JWTs (HS256) and hash-verify. CHANGE THIS in any real deploy.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Movie data ---
TMDB_API_KEY=

# --- OpenAI-compatible LLM + embeddings (OpenAI, Ollama, LM Studio, OpenRouter, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
