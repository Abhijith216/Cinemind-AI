# CineMind backend environment.
# Copy to backend/.env and fill in real values. Never commit .env.

# --- Database (SQLAlchemy URL; docker-compose maps Postgres to localhost:5432) ---
DATABASE_URL=postgresql+asyncpg://cinemind:cinemind@localhost:5432/cinemind

# Optional separate URL for one-off admin work (migrations, ingest CLI,
# embedding backfill). Falls back to DATABASE_URL when empty. In production
# set this to the DIRECT (unpooled) connection string — Neon's pooled
# endpoint can reject migration DDL.
DATABASE_URL_DIRECT=

# TLS for app DB connections: require (managed Postgres: Neon/Supabase/...)
# or disable (local docker-compose Postgres).
DB_SSL=disable

# --- Auth ---
# Used to sign user JWTs (HS256) and hash-verify. CHANGE THIS in any real deploy.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Movie data ---
TMDB_API_KEY=

# --- OpenAI-compatible LLM + embeddings (OpenAI, Ollama, LM Studio, OpenRouter, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Observability ---
# human (readable, local) or json (one JSON object per stdout line —
# production: keeps Render's log stream queryable)
LOG_FORMAT=human
LOG_LEVEL=INFO

# --- Rate limiting (requests per client per minute; 0 disables. Set 0 for
# local demo/offline use, a real number when an API budget is at stake) ---
CHAT_RATE_LIMIT_PER_MINUTE=10
SEARCH_RATE_LIMIT_PER_MINUTE=30
